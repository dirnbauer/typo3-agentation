    <unit id="module.howto.summary">
      <segment>
        <source>{count, plural, one {# step} other {# steps}} from install to first annotation.</source>
        <target>{count, plural, one {# Schritt} other {# Schritte}} von der Installation bis zur ersten Anmerkung.</target>
